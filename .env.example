# Copy to .env (make init does it) and adjust if needed.

# ---- Period ingested (monthly partitions, END is exclusive) -------------------
PERIOD_START=2023-01-01
PERIOD_END=2023-04-01

# ---- Source ----------------------------------------------------------------------
# soda   = real Chicago Data Portal API (needs internet)
# sample = synthetic data with the same schema (offline demo / CI)
SOURCE_MODE=soda
# Optional, free, avoids SODA throttling: https://data.cityofchicago.org/profile/edit/developer_settings
SODA_APP_TOKEN=
SODA_PAGE_SIZE=100000
# One request per day of data; this many days are downloaded in parallel
SODA_WORKERS=4
# Cap rows per month (0 = whole month, ~500-600k rows/month in 2023)
INGEST_MAX_ROWS_PER_PARTITION=0

# ---- Object storage (MinIO) ------------------------------------------------------
# S3-compatible server image (default: cgr.dev/chainguard/minio:latest)
# Untested alternative if it does not pull: MINIO_IMAGE=docker.io/pgsty/silo:RELEASE.2026-09-16T00-00-00Z
#MINIO_IMAGE=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
DATALAKE_ROOT=s3a://datalake

# ---- Spark ---------------------------------------------------------------------
SPARK_DRIVER_MEMORY=3g
SPARK_SHUFFLE_PARTITIONS=16

# ---- Data quality ---------------------------------------------------------------
DQ_MAX_REJECT_RATIO=0.10

# ---- Dagster metadata DB --------------------------------------------------------
DAGSTER_PG_USER=dagster
DAGSTER_PG_PASSWORD=dagster
DAGSTER_PG_DB=dagster
